  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "High-contrast action in the current theme.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Download</button>",
      "css": ".ds-btn-primary{background:var(--cw-accent);border:1px solid var(--cw-accent);border-radius:.375rem;color:var(--cw-accent-ink);padding:.375rem .75rem;font:inherit;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out}.ds-btn-primary:hover,.ds-btn-primary:active{background:var(--cw-accent-hover);border-color:var(--cw-accent-hover);color:var(--cw-accent-ink)}.ds-btn-primary:focus-visible{outline:0;box-shadow:0 0 0 .25rem rgba(var(--bs-primary-rgb),.5)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet outlined action for cancellation and secondary tasks.",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">Cancel</button>",
      "css": ".ds-btn-secondary{background:transparent;border:1px solid var(--cw-border);border-radius:.375rem;color:var(--cw-text);padding:.375rem .75rem;font:inherit;transition:color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out}.ds-btn-secondary:hover,.ds-btn-secondary:active{background:var(--cw-warm);border-color:var(--cw-border);color:var(--cw-text)}.ds-btn-secondary:focus-visible{outline:0;box-shadow:0 0 0 .25rem rgba(var(--bs-primary-rgb),.5)}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "text-input",
      "description": "Compact search or text field with an indigo focus state.",
      "html": "<input class=\"ds-input\" type=\"search\" aria-label=\"Search library\" placeholder=\"Search library\">",
      "css": ".ds-input{background:var(--cw-surface);border:1px solid var(--cw-border);border-radius:.375rem;color:var(--cw-text);font:inherit;padding:.375rem .75rem}.ds-input:focus{border-color:var(--cw-accent);box-shadow:0 0 0 .25rem rgba(var(--bs-primary-rgb),.25);outline:0}"
    },
    {
      "name": "Browse Navigation",
      "kind": "nav",
      "refersTo": "browse-navigation",
      "description": "Surface-led primary navigation with warm hover treatment.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Browse\"><a class=\"ds-nav-brand\" href=\"#\">Calibre-Web</a><a class=\"ds-nav-link\" href=\"#\">Books</a></nav>",
      "css": ".ds-nav{align-items:center;background:var(--cw-surface);border-bottom:1px solid var(--cw-border);color:var(--cw-text);display:flex;gap:.75rem;padding:.5rem .75rem}.ds-nav-brand{color:var(--cw-text);font-size:1.1rem;font-weight:700;text-decoration:none}.ds-nav-link{border-radius:var(--cw-radius);color:var(--cw-text);padding:.65rem .75rem;text-decoration:none}.ds-nav-link:hover{background:var(--cw-warm);color:var(--cw-text)}.ds-nav-link:focus-visible{outline:auto;outline-offset:2px}"
    },
    {
      "name": "Category Tag",
      "kind": "chip",
      "refersTo": "book-tag",
      "description": "Pill-shaped category or language link, not a selected filter.",
      "html": "<a class=\"ds-tag\" href=\"#\">Fiction</a>",
      "css": ".ds-tag{background:transparent;border:1px solid var(--cw-border);border-radius:999px;color:var(--cw-text);display:inline-block;font-size:.75em;font-weight:700;line-height:1;padding:.35em .65em;text-decoration:none;vertical-align:baseline}.ds-tag:hover{color:var(--cw-accent)}.ds-tag:focus-visible{outline:auto;outline-offset:2px}"
    },
    {
      "name": "Book Item",
      "kind": "card",
      "refersTo": "book-card",
      "description": "Cover-first library item with compact title and author metadata.",
      "html": "<article class=\"ds-book\"><a href=\"#\" aria-label=\"Open book\"><div class=\"ds-cover\" aria-hidden=\"true\">Cover</div></a><div class=\"ds-book-meta\"><a class=\"ds-book-title\" href=\"#\">Book title</a><p class=\"ds-book-author\">Author</p></div></article>",
      "css": ".ds-book{color:var(--cw-text);display:flex;min-width:0;flex-direction:column}.ds-cover{aspect-ratio:2/3;background:var(--cw-surface);border-radius:8px;box-shadow:var(--cw-shadow);display:grid;place-items:center;color:var(--cw-muted);font-size:.75rem}.ds-book-meta{margin-top:.65rem}.ds-book-title{color:var(--cw-text);font-size:.95rem;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-book-author{color:var(--cw-muted);font-size:.85rem;margin:0}.ds-book a:hover .ds-book-title{color:var(--cw-accent)}.ds-book a:focus-visible{outline:auto;outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Curator’s Desk — precise, editorial, administration-ready.",
    "overview": "The Standard theme is a quiet working desk for finding, reading, and maintaining a personal Calibre library. Stone neutrals carry the page; indigo identifies actions and linked content; book-cover imagery supplies the strongest editorial character. System typography and familiar Bootstrap controls keep the interface practical rather than ornamental.\n\nLight and dark themes share the same structure, hierarchy, and task flow. Responsive navigation and book grids adapt around the library owner’s current screen without introducing a second visual language.",
    "keyCharacteristics": [
      "Warm stone-neutral surfaces with a clear light/dark pairing.",
      "Indigo actions, visible focus, and consistent SVG iconography.",
      "Cover-led book browsing with restrained metadata and border-defined structure.",
      "Familiar, responsive administration controls rather than decorative chrome."
    ],
    "rules": [
      {
        "name": "The Indigo Action Rule",
        "body": "Use indigo to identify actions, selected states, and links; do not wash large page regions with it.",
        "section": "colors"
      },
      {
        "name": "The Flat Night Rule",
        "body": "Dark-theme surfaces remain shadow-free; use the darker surface and border tokens to separate layers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reserve indigo for primary actions, linked content, and selected controls.",
      "Do keep book covers prominent and their metadata compact.",
      "Do use borders and tonal surfaces for structure before adding shadows.",
      "Do preserve the light/dark theme pairing across navigation, forms, and dialogs."
    ],
    "donts": [
      "Don’t wrap each book item in another decorative card.",
      "Don’t add a display font or ornamental type treatment to administration surfaces.",
      "Don’t use indigo as a large background wash.",
      "Don’t add shadows to dark-theme surfaces."
    ]
  }
}
